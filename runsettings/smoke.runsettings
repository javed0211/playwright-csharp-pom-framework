<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <TestCaseFilter>TestCategory=Smoke</TestCaseFilter>
    <ResultsDirectory>./artifacts/test-results</ResultsDirectory>
  </RunConfiguration>
  <NUnit>
    <NumberOfTestWorkers>3</NumberOfTestWorkers>
    <DefaultTimeout>120000</DefaultTimeout>
  </NUnit>
  <Playwright>
    <BrowserName>chromium</BrowserName>
    <ExpectTimeout>10000</ExpectTimeout>
    <TestIdAttribute>data-test</TestIdAttribute>
    <LaunchOptions>
      <Headless>true</Headless>
    </LaunchOptions>
  </Playwright>
</RunSettings>
