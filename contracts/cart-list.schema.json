{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["carts", "total", "skip", "limit"],
  "properties": {
    "carts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "products"],
        "properties": {
          "id": { "type": "integer" },
          "products": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "title", "quantity", "price"],
              "properties": {
                "id": { "type": "integer" },
                "title": { "type": "string", "minLength": 1 },
                "quantity": { "type": "integer", "minimum": 1 },
                "price": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "total": { "type": "integer", "minimum": 1 },
    "skip": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1 }
  }
}
